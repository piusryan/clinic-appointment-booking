{
  "name": "clinic-backend",
  "version": "1.0.0",
  "description": "P6 Clinic Appointment Booking backend — TypeScript, Express, Mongoose, transactions",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:concurrency": "tsx scripts/concurrent-booking.ts",
    "test:naive": "tsx scripts/naive-booking.ts",
    "test:idor": "jest --runInBand idor",
    "lint": "echo 'typecheck is the gate:' && npm run typecheck"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "clinic-app": "file:..",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "__tests__/.*\\.test\\.ts$",
    "testTimeout": 180000,
    "setupFiles": [
      "<rootDir>/__tests__/setup-env.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "noEmit": false,
            "isolatedModules": true,
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true
          },
          "isolatedModules": true
        }
      ]
    }
  }
}
