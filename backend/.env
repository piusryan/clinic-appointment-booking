# Backend environment (gitignored — never commit the real values)
PORT=4000
NODE_ENV=development

# 24-character string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=8f2b7c1d9e4a6f3b5c8d2e7a1f9b4c6d8e3a5f7b9c1d3e5f7a9b1c3d5e7f9a1b
JWT_REFRESH_SECRET=2c4e6a8b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1a3c5e7b9d1f3a5

# Access token lifetime and refresh lifetime
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# MongoDB. P6 requires a replica set for transactions:
#   MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/clinic?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/clinic?replicaSet=rs0

# The clinic's canonical time zone (IANA). Slot windows are expressed in this zone.
CLINIC_TZ=Europe/Dublin

# CORS origin for the React dev server. Use the frontend base URL in production.
CORS_ORIGIN=http://localhost:5173

# Custom headers set on responses (module 2 deliverable)
X_API_VERSION=1
X_REQUEST_ID_ON=yes
