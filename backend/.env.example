# Backend environment. Copy to backend/.env and fill in the two secrets:
#   cp backend/.env.example backend/.env
#
# The server REFUSES TO BOOT if JWT_ACCESS_SECRET / JWT_REFRESH_SECRET are
# missing, shorter than 32 characters, or still a placeholder — there is no
# fallback secret anywhere in the source (backend/src/config.ts).

PORT=4000
NODE_ENV=development

# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_generate_a_32_byte_random_hex_string
JWT_REFRESH_SECRET=REPLACE_ME_generate_a_different_32_byte_random_hex

# Access token lifetime (jsonwebtoken) and refresh lifetime in days.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# MongoDB. Transactions need a replica set, so a standalone mongod is not
# enough. The brief suggests Atlas; a local single-node replica set is used
# here instead and is equivalent for transactions — see DESIGN.md §11.
#   Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/clinic?retryWrites=true&w=majority
#   Local:  rs.initiate() once, then the URI below
MONGODB_URI=mongodb://localhost:27017/clinic?replicaSet=rs0

# The clinic's canonical time zone (IANA). Slot windows are expressed in this
# zone; everything stored is UTC.
CLINIC_TZ=Europe/Dublin

# CORS origin for the React dev server. Use the frontend base URL in production.
CORS_ORIGIN=http://localhost:5173

# Custom response headers (module 2 deliverable)
X_API_VERSION=1
X_REQUEST_ID_ON=yes
